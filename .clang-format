---
Language: Cpp
Standard: Latest
BasedOnStyle: Google
ColumnLimit: 120
AccessModifierOffset: -2
IndentWidth: 4
InsertNewlineAtEOF: true
Cpp11BracedListStyle: true

IncludeCategories:
  - Regex: '^<Jolt/Jolt\.h>$'
    Priority: 1
    SortPriority: 1
  - Regex: '^<ext/.*\.h>'
    Priority: 2
    SortPriority: 3
  - Regex: '^<.*\.h>'
    Priority: 1
    SortPriority: 2
  - Regex: '^<.*'
    Priority: 2
    SortPriority: 3
  - Regex: '.*'
    Priority: 3
    SortPriority: 4
...
