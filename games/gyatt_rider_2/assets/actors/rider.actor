[capsule format=1]

# A player's rider: 1x2 tiles of 64 px, kinematic (moved by game.MoveRiders, nothing pushes it), on layer 1, its hitbox
# 16 px smaller on each side than its image. A sensor: a vehicle (layer 2) or a cyclist (4) goes through it and sends
# rtype.TriggerEntered, since two kinematic bodies send no contact, and a shot sees it. The server spawns it for a
# client with its slot, its start and the cyclist's white image, which each client tints (scripts/server/players.luau),
# and gives it its owner.
[node path="."]
game.Rider = {}
game.Position = {}
game.Look = { size = (64, 128), layer = 1 }   # Game.riderDrawLayer: over the traffic
game.Gun = {}
game.Score = {}
game.Shot = {}
game.Shield = {}
game.Ready = {}
game.ShieldClock = {}
game.Boosts = {}
game.Boosted = {}
rtype.Transform = {}
rtype.Collider = { shape = 0, size = (32, 96), sensor = true, layer = 1, mask = 6 }
rtype.RigidBody = { type = 1 }
