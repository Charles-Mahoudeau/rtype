[capsule format=1]

# A cyclist, 1x2 tiles: slower than every vehicle, and a boost for the one who shoots it.
# Placed and moved by server/traffic.luau.
[node path="."]
rtype.Transform = {}
game.Position = {}
game.Look = { texture = "cyclists/cyclist.png", layer = 0 }   # under the riders
game.Driving = { speed = 25 }   # world units per second, up the view
game.Cyclist = {}   # no boost: the server draws one when it spawns the cyclist
rtype.Collider = { shape = 0, size = (64, 128), layer = 4, mask = 0 }   # meets nothing; a shot hits it
rtype.RigidBody = { type = 1 }   # kinematic: moved by its Transform, pushed by nothing
