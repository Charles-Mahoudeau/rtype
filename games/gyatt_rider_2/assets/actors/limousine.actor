[capsule format=1]

# A limousine, 2x7 tiles. Placed and moved by server/traffic.luau.
[node path="."]
rtype.Transform = {}
game.Position = {}
game.Speed = {}
game.Look = { texture = "vehicles/limousine.png", size = (128, 448), layer = 0 }   # under the riders
game.Driving = { speed = 69 }   # world units per second, up the view
rtype.Collider = { shape = 0, size = (96, 416), layer = 2, mask = 1 }   # meets the riders, stops shots
rtype.RigidBody = { type = 1 }   # kinematic: moved by its Transform, pushed by nothing
