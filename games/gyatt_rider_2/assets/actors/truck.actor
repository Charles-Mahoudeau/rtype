[capsule format=1]

# A truck, 2x5 tiles. Placed and moved by server/traffic.luau.
[node path="."]
rtype.Transform = {}
game.Position = {}
game.Look = { texture = "vehicles/truck.png", layer = 0 }   # under the riders
game.Driving = { speed = 45 }   # world units per second, up the view
rtype.Collider = { shape = 0, size = (128, 320), layer = 2, mask = 1 }   # meets the riders, stops shots
rtype.RigidBody = { type = 1 }   # kinematic: moved by its Transform, pushed by nothing
