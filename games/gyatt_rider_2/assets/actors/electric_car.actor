[capsule format=1]

# An electric car, 2x2 tiles: the fastest. Placed and moved by server/traffic.luau.
[node path="."]
rtype.Transform = {}
game.Position = {}
game.Speed = {}
game.Look = { texture = "vehicles/electric_car.png", size = (128, 128), layer = 0 }   # under the riders
game.Driving = { speed = 90 }   # world units per second, up the view
rtype.Collider = { shape = 0, size = (96, 96), layer = 2, mask = 1 }   # meets the riders, stops shots
rtype.RigidBody = { type = 1 }   # kinematic: moved by its Transform, pushed by nothing
